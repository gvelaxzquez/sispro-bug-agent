# Copia este archivo a .yitpro.env EN LA RAIZ DEL REPO donde vas a usar la skill
# (ej. la raiz de Clikalo), no dentro del repo del plugin. No lo commitees (esta en .gitignore).
#
# Mejor opcion: no llenes esto a mano. Ve a tu Dashboard YITPRO -> boton
# "Agente IA de Bugs" -> Paso 3 -> descarga el .yitpro.env ya lleno para tu
# proyecto/repo y suelta ese archivo directo en la raiz del repo.

# Dominio donde corre YITPRO en tu ambiente.
YITPRO_BASE_URL=http://localhost:47566

# Genera esta key desde el wizard de tu Dashboard YITPRO ("Agente IA de Bugs" -> Paso 1).
# Se muestra una sola vez. Si la pierdes, genera una nueva (invalida la anterior).
YITPRO_API_KEY=

# Clave del proyecto (no un id numerico), ej. CLIKALOV2. La eliges en el Paso 3 del wizard.
YITPRO_PROJECT=

# Nombre del repositorio dentro de ese proyecto, ej. clikaloV2 (debe hacer match exacto
# con lo que YITPRO espera para poder ligar el commit al reportar tiempo).
YITPRO_REPOSITORY=
