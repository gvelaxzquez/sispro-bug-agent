# Copia este archivo a config/sispro.env DENTRO DEL REPO donde vas a usar la skill
# (ej. la raiz de Clikalo), no dentro del repo del plugin. No lo commitees (esta en .gitignore).

# URL base de SISPRO para el ambiente que estas usando.
SISPRO_BASE_URL=http://localhost:47566

# Genera esta key en tu Dashboard personal de SISPRO:
# /Dashboard/p/{tuClave} -> boton "Generar API Key Agente IA".
# Se muestra una sola vez. Si la pierdes, genera una nueva (invalida la anterior).
SISPRO_API_KEY=

# idProyecto fijo de este repo en SISPRO (ej. Clikalo=246).
# Lo ves en la URL/Dashboard del proyecto dentro de SISPRO.
SISPRO_PROJECT_ID=
